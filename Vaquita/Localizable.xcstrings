    "Revisá el importe y los decimales de esta moneda. Usá un número positivo o cero, sin separadores de miles. Podés usar coma o punto decimal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisá el importe y los decimales de esta moneda. Usá un número positivo o cero, sin separadores de miles. Podés usar coma o punto decimal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the amount and this currency’s decimal places. Use a positive number or zero, without thousands separators. You can use a comma or a decimal point."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o valor e as casas decimais desta moeda. Use um número positivo ou zero, sem separadores de milhares. Você pode usar vírgula ou ponto decimal."
          }
        }
      }
    },
