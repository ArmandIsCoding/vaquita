    "Última actualización: 5 de octubre de 2026\nVaquita es una aplicación desarrollada por Armando Meabe para organizar eventos, registrar aportes y calcular cómo repartir gastos. No requiere una cuenta y no realiza pagos ni transferencias bancarias.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última actualización: 5 de octubre de 2026\nVaquita es una aplicación desarrollada por Armando Meabe para organizar eventos, registrar aportes y calcular cómo repartir gastos. No requiere una cuenta y no realiza pagos ni transferencias bancarias."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last updated: October 5, 2026\nVaquita is an app developed by Armando Meabe to organize events, record contributions and calculate how to split expenses. It does not require an account and does not make payments or bank transfers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Última atualização: 5 de outubro de 2026\nO Vaquita é um aplicativo desenvolvido por Armando Meabe para organizar eventos, registrar contribuições e calcular como dividir gastos. Não exige uma conta e não realiza pagamentos nem transferências bancárias."
          }
        }
      }
    },
    "• %@ le paga %@ a %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@ le paga %@ a %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@ pays %2$@ to %3$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@ paga %2$@ a %3$@."
          }
        }
      }
    },
    "• %@: aportó %@; le corresponde %@.": {
