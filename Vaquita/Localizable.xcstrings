            "state": "translated",
            "value": "• %@: paid %@; their share is %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: pagou %@; sua parte é %@."
          }
        }
      }
    }
  },
