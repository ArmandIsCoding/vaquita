<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Vaquita.Converters"
             x:Class="Vaquita.Pages.VaquitaDetallePage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container"
             BackgroundColor="#F2F2F7">

    <ContentPage.Resources>
        <converters:MonedaConverter x:Key="MonedaConverter" />
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="TextColor" Value="#8E8E93" />
            <Setter Property="Margin" Value="20,0,20,8" />
        </Style>
        <Style x:Key="RowText" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="#000000" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" RowDefinitions="64,Auto,Auto" Padding="18,2,18,10">
            <Border Grid.Row="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid HeightRequest="46" WidthRequest="50">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Label Text="‹"
                           FontSize="38"
                           TextColor="#000000"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TranslationY="-2" />
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    Padding="4,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="0">
                    <Grid x:Name="CompartirButton" HeightRequest="46" WidthRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCompartirClicked" />
                        </Grid.GestureRecognizers>
                        <Grid HeightRequest="25" WidthRequest="25">
                            <Border HeightRequest="17"
                                    WidthRequest="21"
                                    VerticalOptions="End"
                                    Stroke="#000000"
                                    StrokeThickness="2"
                                    BackgroundColor="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="3" />
                                </Border.StrokeShape>
                            </Border>
                            <Label Text="↑"
                                   FontSize="25"
                                   TextColor="#000000"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Start"
                                   TranslationY="-7" />
                        </Grid>
                    </Grid>
                    <BoxView x:Name="ToolbarSeparator"
                             WidthRequest="1"
                             HeightRequest="26"
                             VerticalOptions="Center"
                             BackgroundColor="#D1D1D6" />
                    <Grid HeightRequest="46" WidthRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgregarClicked" />
                        </Grid.GestureRecognizers>
                        <Label Text="+"
                               FontSize="32"
                               TextColor="#000000"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </HorizontalStackLayout>
            </Border>

            <Label x:Name="NombreVaquitaLabel"
                   Grid.Row="1"
                   FontFamily="OpenSansSemibold"
                   FontAttributes="Bold"
                   FontSize="36"
                   TextColor="#000000"
                   LineBreakMode="TailTruncation"
                   Margin="0,4,0,0" />
            <Label x:Name="FechaLabel"
                   Grid.Row="2"
                   FontSize="14"
                   TextColor="#8E8E93"
                   Margin="2,0,0,0" />
        </Grid>

        <Grid x:Name="EmptyState" Grid.Row="1" Padding="30,0,30,100">
            <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                <Label Text="👥" FontSize="50" HorizontalTextAlignment="Center" />
                <Label Text="Todavía no hay participantes"
                       FontFamily="OpenSansSemibold"
                       FontSize="25"
                       TextColor="#000000"
                       HorizontalTextAlignment="Center" />
                <Label Text="Agregá personas para calcular el reparto."
                       FontSize="16"
                       TextColor="#8E8E93"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView x:Name="Contenido" Grid.Row="1">
            <VerticalStackLayout Padding="18,22,18,42" Spacing="28">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Participantes" Style="{StaticResource SectionTitle}" />
                    <Border StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Participantes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Reveal">
                                                <SwipeItem Text="Eliminar"
                                                           BackgroundColor="#FF3B30"
                                                           CommandParameter="{Binding .}"
                                                           Invoked="OnEliminarParticipanteInvoked" />
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="*,Auto" HeightRequest="58" Padding="20,0">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                          Tapped="OnParticipanteTapped" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{Binding Nombre}"
                                                       Style="{StaticResource RowText}"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="#007AFF" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding MontoPagado, Converter={StaticResource MonedaConverter}}"
                                                       Style="{StaticResource RowText}"
                                                       TextColor="#34C759" />
                                            </Grid>
                                            <BoxView HeightRequest="1" Margin="20,0" BackgroundColor="#E5E5EA" />
                                        </VerticalStackLayout>
                                    </SwipeView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="LiquidacionSection" Spacing="0">
                    <Label Text="¿Cómo se paga?" Style="{StaticResource SectionTitle}" />
                    <Border StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Transacciones}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="36,*,Auto" MinimumHeightRequest="58" Padding="18,0">
                                            <Border HeightRequest="22"
                                                    WidthRequest="22"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="#007AFF"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="11" />
                                                </Border.StrokeShape>
                                                <Label Text="→"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="15"
                                                       TextColor="#FFFFFF"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource RowText}"
                                                   LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding De}" FontAttributes="Bold" />
                                                        <Span Text=" paga a " />
                                                        <Span Text="{Binding A}" FontAttributes="Bold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding Monto, Converter={StaticResource MonedaConverter}}"
                                                   Style="{StaticResource RowText}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Margin="54,0,20,0" BackgroundColor="#E5E5EA" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="0">
                    <Label Text="Resumen General" Style="{StaticResource SectionTitle}" />
                    <Border StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="20,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="58,1,58">
                            <Label Text="Total Gastado:" Style="{StaticResource RowText}" />
                            <Label x:Name="TotalLabel" Grid.Column="1" Style="{StaticResource RowText}" />
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="#E5E5EA" />
                            <Label Grid.Row="2" Text="Costo por Participante:" Style="{StaticResource RowText}" />
                            <Label x:Name="PorParticipanteLabel"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Style="{StaticResource RowText}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#007AFF" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
