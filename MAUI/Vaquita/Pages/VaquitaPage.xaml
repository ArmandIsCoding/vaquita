<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vaquita.Pages.VaquitaPage"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container"
             BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" RowDefinitions="64,Auto,Auto" Padding="18,2,18,14">
            <Border Grid.Row="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid HeightRequest="46" WidthRequest="50">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelarClicked" />
                    </Grid.GestureRecognizers>
                    <Label Text="×"
                           FontSize="30"
                           TextColor="#000000"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="CrearContainer"
                    Grid.Row="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    StrokeThickness="0"
                    BackgroundColor="#007AFF"
                    Opacity="0.35"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Grid HeightRequest="46" Padding="20,0">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGuardarClicked" />
                    </Grid.GestureRecognizers>
                    <Label Text="Crear"
                           FontFamily="OpenSansSemibold"
                           FontSize="17"
                           TextColor="#FFFFFF"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Label Grid.Row="1"
                   Text="Nueva vaquita"
                   FontFamily="OpenSansSemibold"
                   FontAttributes="Bold"
                   FontSize="36"
                   TextColor="#000000"
                   Margin="0,4,0,0" />
            <Label Grid.Row="2"
                   Text="Ponéle un nombre que después puedas reconocer."
                   FontSize="15"
                   TextColor="#8E8E93"
                   Margin="2,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,22,18,30" Spacing="8">
                <Label Text="INFORMACIÓN"
                       Margin="16,0,0,0"
                       FontSize="13"
                       TextColor="#6D6D72" />
                <Border StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="18,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="58,1,58">
                        <Entry x:Name="NombreEntry"
                               Grid.ColumnSpan="2"
                               Placeholder="Ej. Viaje a Córdoba"
                               ReturnType="Done"
                               FontSize="17"
                               TextColor="#000000"
                               PlaceholderColor="#8E8E93"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"
                               TextChanged="OnNombreTextChanged" />
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="#E5E5EA" />
                        <Label Grid.Row="2"
                               Text="Fecha"
                               FontSize="17"
                               TextColor="#000000"
                               VerticalTextAlignment="Center" />
                        <DatePicker x:Name="FechaPicker"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    Format="dd/MM/yyyy"
                                    FontSize="17"
                                    TextColor="#007AFF"
                                    BackgroundColor="Transparent" />
                    </Grid>
                </Border>
                <Label Text="Puede ser un viaje, una salida, un regalo o cualquier gasto compartido."
                       Margin="16,0"
                       FontSize="13"
                       LineHeight="1.15"
                       TextColor="#6D6D72" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
