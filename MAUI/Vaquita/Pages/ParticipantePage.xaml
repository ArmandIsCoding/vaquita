<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vaquita.Pages.ParticipantePage"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container"
             BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="60,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="100,*,100"
              Padding="8,0"
              BackgroundColor="#F2F2F7">
            <Label Text="Cancelar"
                   FontSize="17"
                   TextColor="#007AFF"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarClicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label x:Name="TituloLabel"
                   Grid.Column="1"
                   FontFamily="OpenSansSemibold"
                   FontSize="17"
                   TextColor="#000000"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
            <Label x:Name="GuardarLabel"
                   Grid.Column="2"
                   Text="Guardar"
                   FontFamily="OpenSansSemibold"
                   FontSize="17"
                   TextColor="#007AFF"
                   Opacity="0.35"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGuardarClicked" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,26,18,30" Spacing="8">
                <Label Text="PARTICIPANTE"
                       Margin="16,0,0,0"
                       FontSize="13"
                       TextColor="#6D6D72" />

                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        Padding="16,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,44" RowDefinitions="54,1,54">
                        <Entry x:Name="NombreEntry"
                               Grid.ColumnSpan="2"
                               Placeholder="Nombre"
                               ReturnType="Next"
                               FontSize="17"
                               TextColor="#000000"
                               PlaceholderColor="#8E8E93"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"
                               TextChanged="OnNombreTextChanged" />
                        <Label Grid.Column="2"
                               Text="⌄"
                               FontSize="25"
                               TextColor="#007AFF"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMostrarNombresClicked" />
                            </Label.GestureRecognizers>
                        </Label>

                        <BoxView Grid.Row="1"
                                 Grid.ColumnSpan="3"
                                 BackgroundColor="#E5E5EA" />

                        <Label Grid.Row="2"
                               Text="$"
                               FontSize="17"
                               TextColor="#000000"
                               VerticalTextAlignment="Center" />
                        <Entry x:Name="MontoEntry"
                               Grid.Row="2"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Margin="12,0,0,0"
                               Placeholder="0"
                               Keyboard="Numeric"
                               ReturnType="Done"
                               FontSize="17"
                               TextColor="#000000"
                               PlaceholderColor="#8E8E93"
                               BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <Border x:Name="SugerenciasContainer"
                        IsVisible="False"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        Padding="16,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding NombresSugeridos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding .}"
                                           HeightRequest="46"
                                           FontSize="17"
                                           TextColor="#007AFF"
                                           VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                  Tapped="OnSugerenciaTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <BoxView HeightRequest="1" BackgroundColor="#E5E5EA" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="ErrorNombreLabel"
                       IsVisible="False"
                       Text="Esta persona ya participa en esta vaquita."
                       Margin="16,0"
                       FontSize="13"
                       TextColor="#FF3B30" />

                <Label Text="Podés escribir un nombre nuevo o elegir una persona usada anteriormente."
                       Margin="16,0"
                       FontSize="13"
                       LineHeight="1.15"
                       TextColor="#6D6D72" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
