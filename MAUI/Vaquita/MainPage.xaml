<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Vaquita.Converters"
             x:Class="Vaquita.MainPage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container"
             BackgroundColor="#F2F2F7">

    <ContentPage.Resources>
        <converters:MonedaConverter x:Key="MonedaConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" RowDefinitions="64,Auto" Padding="18,2,18,10">
            <Border Grid.Row="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid HeightRequest="46" WidthRequest="54">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNuevaVaquitaClicked" />
                    </Grid.GestureRecognizers>
                    <Label Text="+"
                           FontSize="32"
                           TextColor="#000000"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Label Grid.Row="1"
                   Text="Vaquita"
                   FontFamily="OpenSansSemibold"
                   FontAttributes="Bold"
                   FontSize="42"
                   TextColor="#000000"
                   Margin="0,4,0,0" />
        </Grid>

        <Grid x:Name="EmptyState" Grid.Row="1" Padding="30,0,30,100">
            <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                <Label Text="🐮"
                       FontSize="56"
                       HorizontalTextAlignment="Center" />
                <Label Text="Todavía no hay vaquitas"
                       FontFamily="OpenSansSemibold"
                       FontSize="26"
                       TextColor="#000000"
                       HorizontalTextAlignment="Center" />
                <Label Text="Creá una para empezar a dividir gastos."
                       FontSize="16"
                       TextColor="#8E8E93"
                       HorizontalTextAlignment="Center" />
                <Button Text="Nueva vaquita"
                        Clicked="OnNuevaVaquitaClicked"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0"
                        Padding="20,10"
                        CornerRadius="22"
                        FontSize="16"
                        BackgroundColor="#007AFF"
                        TextColor="#FFFFFF" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView x:Name="Contenido" Grid.Row="1">
            <VerticalStackLayout Padding="18,22,18,42" Spacing="8">
                <Label Text="MIS VAQUITAS"
                       Margin="16,0,0,0"
                       FontSize="13"
                       TextColor="#6D6D72" />
                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding Vaquitas}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem Text="Eliminar"
                                                   BackgroundColor="#FF3B30"
                                                   CommandParameter="{Binding .}"
                                                   Invoked="OnEliminarVaquitaInvoked" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border StrokeThickness="0"
                                        BackgroundColor="#FFFFFF"
                                        Padding="20,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                  Tapped="OnVaquitaTapped" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding Nombre}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="20"
                                               TextColor="#000000"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="›"
                                               FontSize="28"
                                               TextColor="#C7C7CC"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding FechaTexto}"
                                               FontSize="14"
                                               TextColor="#8E8E93" />
                                        <Grid Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,Auto"
                                              Margin="0,12,0,0">
                                            <Label Text="{Binding ParticipantesTexto}"
                                                   FontSize="15"
                                                   TextColor="#8E8E93" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Total, Converter={StaticResource MonedaConverter}}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="17"
                                                   TextColor="#34C759" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
