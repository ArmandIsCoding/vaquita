<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vaquita.MainPage"
             Title="Vaquita">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="LimpiarToolbarItem" Text="Limpiar" Clicked="OnLimpiarClicked" />
        <ToolbarItem x:Name="CompartirToolbarItem" Text="Compartir" Clicked="OnCompartirClicked" />
        <ToolbarItem Text="Agregar" Clicked="OnAgregarClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*">
        <VerticalStackLayout x:Name="EmptyState" Grid.Row="0" Padding="24,72" Spacing="12">
            <Label Text="👥" FontSize="56" HorizontalTextAlignment="Center" />
            <Label Text="No hay nadie" Style="{StaticResource Headline}" HorizontalTextAlignment="Center" />
            <Label Text="Agregá a los invitados para empezar el asado."
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>

        <ScrollView x:Name="Contenido" Grid.Row="1">
            <VerticalStackLayout Spacing="24">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Invitados" Style="{StaticResource SubHeadline}" />
                    <CollectionView x:Name="ParticipantesView" SelectionMode="Single" SelectionChanged="OnParticipanteSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,10">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding MontoPagado, StringFormat='{0:C0}'}"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="Eliminar" FontSize="12" BackgroundColor="Transparent"
                                            TextColor="{StaticResource Red}" CommandParameter="{Binding}" Clicked="OnEliminarClicked" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="LiquidacionSection" Spacing="8">
                    <Label Text="¿Cómo se paga?" Style="{StaticResource SubHeadline}" />
                    <CollectionView x:Name="TransaccionesView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="8">
                                    <Label Text="→" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Margin="8,0" Text="{Binding Descripcion}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Monto, StringFormat='{0:C0}'}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Resumen general" Style="{StaticResource SubHeadline}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="12" BackgroundColor="{StaticResource Gray100}">
                        <Label Text="Total gastado:" />
                        <Label x:Name="TotalLabel" Grid.Column="1" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="Costo por invitado:" />
                        <Label x:Name="PorInvitadoLabel" Grid.Row="1" Grid.Column="1" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
